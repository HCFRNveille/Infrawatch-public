  "method": {
    "principle": "Mesure actuelle -> seuil opérationnel -> baseline historique du même créneau sur journées antérieures -> anomalie statistique -> persistance/concentration -> N0-N4.",
    "baseline_note": "La gravité opérationnelle est déterminée par des seuils absolus ou des indicateurs territoriaux. Les baselines statistiques sont construites uniquement à partir des journées civiles antérieures et des observations appartenant au même créneau opérationnel matin ou soir. Les collectes réalisées le même jour que l'observation analysée sont exclues. À partir de 14 observations historiques comparables, la baseline caractérise le caractère atypique de l'observation mais ne peut pas produire seule un niveau de gravité supérieur à celui justifié par l'amplitude observée. Cette doctrine s'applique à l'électricité, au nucléaire, aux télécommunications mobiles, aux carburants, au ferroviaire et au routier. Le gaz repose directement sur la vigilance opérationnelle Smart NaTran.",
    "electricity_thresholds": {
      "N1": "|écart consommation/prévision| >= 5 %",
      "N2": "|écart consommation/prévision| >= 10 %",
      "N3": "|écart consommation/prévision| >= 20 %",
      "N4": "Non produit automatiquement à partir du seul écart consommation/prévision ou du solde physique."
    },
    "nuclear_thresholds": {
      "availability": {
        "N1": "< 55 %",
        "N2": "< 45 %",
        "N3": "< 30 %"
      },
      "unplanned_events": {
        "N1": ">= 8",
        "N2": ">= 12",
        "N3": ">= 20"
      },
      "N4": "Non produit automatiquement par ces seuls indicateurs."
    },
    "telecom_thresholds": {
      "national_down_ratio_pct": {
        "N1": ">= 2 %",
        "N2": ">= 3 %",
        "N3": ">= 5 %"
      },
      "territorial": {
        "N1": "Au moins un hotspot >= 20 % sur deux opérateurs ou au moins 5 clusters à quatre opérateurs.",
        "N2": "Au moins 3 hotspots multi-opérateurs >= 20 % et ratio national >= 2 %."
      },
      "N4": "Non produit automatiquement par ces seuls indicateurs."
    },
    "gas_mapping": {
